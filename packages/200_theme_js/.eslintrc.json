{
  "env": {
    "es6": true,
    "browser": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module",
    "ecmaFeatures": {
      "modules": true,
      "sourceType": "module",
      "jsx": true
    }
  },
  "rules": {
    "indent": [
      "warn",
      2
    ],
    "linebreak-style": [
      "error",
      "unix"
    ],
    "quotes": [
      "warn",
      "single"
    ],
    "semi": [
      "error",
      "always"
    ]
  },
  "overrides": [
    {
      "files": [
        "js/api/**/*.js"
      ],
      "env": {
        "browser": true,
        "node": true
      },
      "rules": {
        "no-undef": "off",
        "no-unused-vars": "warn",
        "semi": "warn",
        "no-mixed-spaces-and-tabs": "warn",
        "no-prototype-builtins": "warn",
        "no-constant-condition": "warn",
        "no-empty": "warn",
        "no-cond-assign": "warn"
      }
    }
  ]
}
