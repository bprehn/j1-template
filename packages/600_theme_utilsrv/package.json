{
  "private": true,
  "name": "utilsrv",
  "version": "2026.0.14",
  "description": "Utility service package for J1 development",
  "main": "daemon.js",
  "config": {
    "server_enabled": "false",
    "verbosity": "false",
    "environment": "dev",
    "project_path": "../400_theme_site",
    "data_path": "../400_theme_site/_data",
    "log_file": "../../log/messages.log"
  },
  "scripts": {
    "audit": "npm audit",
    "utilsrv": "node daemon.js",
    "develop": "npm run utilsrv",
    "clean": "run-p -s clean:*",
    "clean:log": "shx rm -rf log",
    "clean:lock": "shx rm -f package-lock.json *.lock"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5",
    "shx": "^0.3.4"
  }
}
