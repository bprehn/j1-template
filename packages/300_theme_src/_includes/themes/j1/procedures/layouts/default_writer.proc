{% comment %}
 # -----------------------------------------------------------------------------
 # ~/_includes/themes/j1/procedures/layouts/default_writer.proc
 # Liquid PROCEDURE to write|place the HTML markup for the layout DEFAULT
 #
 # Product/Info:
 # https://jekyll.one
 #
 # Copyright (C) 2023-2026 Juergen Adams
 #
 # J1 Template is licensed under the MIT License.
 # See: https://github.com/jekyll-one-org/j1-template/blob/main/LICENSE
 # -----------------------------------------------------------------------------
 # Test data:
 #    liquid_var:  {{ liquid_var | debug }}
 # -----------------------------------------------------------------------------
{% endcomment %}

{% comment %} Variables
-------------------------------------------------------------------------------- {% endcomment %}
{% assign placement   = include.region %}
{% assign items       = include.items | where_exp: 'lane_item', 'lane_item.lane.region == placement' %}


{% comment %} Main
-------------------------------------------------------------------------------- {% endcomment %}

{% assign home_lane_visibility = site.data.layouts.home_visibility %}

{% for lane_item in items %}
  {% assign lane = lane_item.lane %}
  {% assign enabled = lane.enabled %}
  {% assign type = lane.type %}
  {% assign base = lane.base %}
  {% assign path = lane.path %}
  {% assign file = lane.file %}
  {% assign id = lane.id %}
  {% assign visibility_key = lane.visibility_key %}
  {% assign class = lane.class %}

  {% comment %} Apply homepage lane visibility overrides from data file
  ---------------------------------------------------------------------------- {% endcomment %}
  {% if page.layout == 'home' and home_lane_visibility and id %}
    {% assign visibility_lookup_key = id %}
    {% if visibility_key and visibility_key != '' %}
      {% assign visibility_lookup_key = visibility_key %}
    {% endif %}

    {% assign home_lane_override = home_lane_visibility[visibility_lookup_key] %}
    {% if home_lane_override == nil %}
      {% assign home_lane_override = home_lane_visibility[id] %}
    {% endif %}

    {% unless home_lane_override == nil or home_lane_override == '' %}
      {% if home_lane_override == 'true' %}
        {% assign home_lane_override = true %}
      {% elsif home_lane_override == 'false' %}
        {% assign home_lane_override = false %}
      {% endif %}
      {% assign enabled = home_lane_override %}
    {% endunless %}
  {% endif %}

  {% comment %} Skip disabled lanes
  ---------------------------------------------------------------------------- {% endcomment %}
  {% unless enabled %} {% continue %} {% endunless %}

  {% comment %} Process all regions for the given layout
  ---------------------------------------------------------------------------- {% endcomment %}
  {% assign base = base | remove_first: '_includes/' %}

  {% if type == 'async' %}
    {% if placement == 'body-footer' %}
      <footer id="{{ id }}" class="{{ class }}"></footer>
    {% else %}
      <div id="{{ id }}" class="{{ class }}"></div>
    {% endif %}
  {% elsif type == 'sync' %}
    {% capture include_path %}{{base}}/{{path}}/{{file}}{% endcapture %}
    {% include {{ include_path }} region=placement %}
  {% endif %}

{% endfor %}

{% comment %} END Process all items
-------------------------------------------------------------------------------- {% endcomment %}
{% assign items = false %}
